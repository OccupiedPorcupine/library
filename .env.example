# Copy to .env and fill in. .env is gitignored: never commit real credentials (this repo is public).

# Where the server listens
PORT=8080

# SQLite metadata database and cache live here (keep it on a persistent volume)
DATA_DIR=./data

# Storage backend: "local" (a folder, e.g. a mounted NAS share) or "s3" (MinIO, Garage, etc.)
STORAGE_DRIVER=local

# --- local driver ---
# Point this at your NAS mount, e.g. /mnt/nas/books
LOCAL_STORAGE_PATH=./data/books

# --- s3 driver ---
S3_ENDPOINT=http://minio.local:9000
S3_REGION=us-east-1
S3_BUCKET=library
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO and most home lab S3 servers need path-style URLs
S3_FORCE_PATH_STYLE=true
# Optional folder inside the bucket
S3_PREFIX=

# docker compose only: host folder with your books (e.g. the NAS share mounted on the VM)
BOOKS_PATH=/mnt/nas/books

# --- book metadata ---
# Look up missing details and covers on Open Library and Google Books (free). Set to false to stay offline.
METADATA_ONLINE=true
# Optional Google Books API key; works without one at a lower rate limit
GOOGLE_BOOKS_API_KEY=

# --- AI (optional) ---
# Reads the opening pages on upload to clean up messy titles and authors, and sorts books onto shelves.
# Leave empty to turn it off. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
# Put new books on existing shelves automatically (new shelves are only suggested, never created)
AI_AUTO_SHELVE=true
